class Search_word:
    def find_word(self, wordlist1, wordlist2, dict1, dict2):
        word_entered = input("Enter the word to be searched for: ").strip().lower()
                appearanceInOne = dict1.get(word_entered, 0)
        appearanceInTwo = dict2.get(word_entered, 0)
                print("\n" + "-"*40)
        print(f"Word searched for: '{word_entered}'")
        print(f"'{word_entered}' found {appearanceInOne} times in document one.")
        print(f"'{word_entered}' found {appearanceInTwo} times in document two.")
        print("-"*40)
                # Returns True only if found in both documents per assignment rules
        if word_entered in wordlist1 and word_entered in wordlist2:
            print("Return Result: True")
            return True
        else:
            print("Return Result: False")
            return False
